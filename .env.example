# Copy to .env on the server and fill in. Never commit .env.
TZ=Africa/Johannesburg
PYLTJIES_PORT=8080
BACKUP_KEEP=14
PUBLIC_URL=https://pyltjies.confuzled.co.za
# 1 = behind a proxy: trust X-Forwarded-For and -Proto (rate limits, Secure cookie). 0 if the port is reached directly.
TRUST_PROXY=1

# The first person who can sign in. Anyone already in the league can then invite friends.
OWNER_EMAIL=

# Sign-in codes and invites by email. Unset: they go to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pyltjies <pyltjies@confuzled.co.za>
